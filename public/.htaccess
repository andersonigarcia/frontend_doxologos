<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Forçar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Não redirecionar arquivos que existem
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Não redirecionar arquivos com extensões específicas
  RewriteCond %{REQUEST_URI} !\.(js|css|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot|json|xml|txt)$ [NC]
  
  RewriteRule ^ index.html [L]
</IfModule>

# Compressão GZIP para aceleração de transferência
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Tipos MIME corretos para JavaScript modules e fontes
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Política de Expiração de Recursos Estáticos (PageSpeed Cache Policy)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Imagens (1 ano)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fontes (1 ano)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS e JS do bundle Vite (1 ano com hash)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # HTML nunca deve ficar em cache longo
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cabeçalhos HTTP de Cache Control
<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # Por padrão, documentos HTML servidos via CDN com revalidação pelo cliente
  Header set Cache-Control "public, s-maxage=604800, max-age=0, must-revalidate"

  # Cache imutável de 1 ano para o bundle do Vite (/assets/)
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Cache imutável de 1 ano para imagens e fontes públicas
  <If "%{REQUEST_URI} =~ m#\.(ico|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|eot)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
